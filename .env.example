# =============================================================================
# Exemplo de variáveis de ambiente — Annalú e os Tesouros Escondidos
# -----------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha com valores locais.
# NUNCA commite o arquivo `.env` nem credenciais reais.
# Todos os valores abaixo são FICTÍCIOS e servem apenas de referência.
# =============================================================================

# Conexão com o PostgreSQL (usada pelo Prisma).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/annalu?schema=public"

# Banco DESCARTÁVEL para testes de integração. O guard de segurança só executa
# TRUNCATE/reset quando o nome do banco contém "_test", "test" ou "integration".
# NUNCA aponte para banco de produção. (Fallback: usa DATABASE_URL se ausente.)
TEST_DATABASE_URL="postgresql://annalu_test:annalu_test@localhost:5432/annalu_test?schema=public"

# Armazenamento de objetos compatível com S3 (acesso via abstração interna).
# Use um bucket PRIVADO. Não crie buckets públicos.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="annalu-imagens-privadas"
S3_ACCESS_KEY_ID="chave-de-acesso-ficticia"
S3_SECRET_ACCESS_KEY="segredo-ficticio"

# Nível de log estruturado: debug | info | warn | error
LOG_LEVEL="info"

# URL pública da aplicação (usada apenas para montagem de links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
