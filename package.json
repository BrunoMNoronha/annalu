{
  "name": "annalu",
  "version": "0.0.0",
  "private": true,
  "description": "Annalú e os Tesouros Escondidos — jogo web mobile first para crianças (fundação técnica).",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "docs:check-links": "node scripts/check-links.mjs",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "validate": "next lint && tsc --noEmit && vitest run && node scripts/check-links.mjs"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@prisma/client": "^6.16.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.4",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
